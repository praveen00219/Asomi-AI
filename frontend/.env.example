# Asomi mobile configuration.
# Copy to .env and fill in. NEVER commit .env.
#
# EVERY value here is EXPO_PUBLIC_, which means it is compiled into the APK and
# readable by anyone who unzips it. Never put an API key, a service-role key or
# any other secret in this file. The Anthropic key lives only in backend/.env
# (see project_planning/docs/09-security-and-privacy.md).

# The backend from Phase 1. On a physical device, localhost is the PHONE's
# localhost, so this must be your laptop's LAN IP, not 127.0.0.1.
# Find it with `ipconfig` (look for IPv4 Address on your Wi-Fi adapter).
EXPO_PUBLIC_API_URL=http://192.168.1.5:3000

# Shared secret matching MVP_API_KEY in backend/.env.
# NOTE: being EXPO_PUBLIC_, this is extractable from the APK. It throttles
# casual abuse of the endpoint; it is not real authentication. Phase 9 replaces
# it with per-user Supabase tokens.
EXPO_PUBLIC_API_KEY=

# ---- v2: not read by any code yet (Phase 9-10) ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_POSTHOG_KEY=
