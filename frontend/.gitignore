node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects - generated by `expo prebuild`, not source
/android
/ios

# Secrets. Only .env.example belongs in the repo.
# EXPO_PUBLIC_ values are embedded in the app bundle and readable by anyone who
# downloads the APK, so a real secret must never go in any of these.
.env
.env.local
.env.*.local

