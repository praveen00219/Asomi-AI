# Asomi server configuration.
# Copy to .env and fill in. NEVER commit .env.
#
# The AI key lives ONLY here, never in the mobile app and never in an
# EXPO_PUBLIC_ variable. See project_planning/docs/09-security-and-privacy.md.

# ---- Server ----
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed origins. Empty = allow all (dev only).
# The mobile app is a native client and sends no Origin header, so this only
# matters if a web client is ever added.
CORS_ORIGINS=

# ---- AI ----
# Which provider the ai/router.ts seam resolves to: claude | mock
# `mock` returns deterministic canned actions and needs no API key - use it to
# work on the app without spending tokens.
AI_PROVIDER=claude

ANTHROPIC_API_KEY=

# Real model IDs. NOTE: docs/14-extra-docs.md lists `claude-haiku-5-5` and
# `claude-sonnet-5-5`, which do not exist. These are the correct ones.
AI_MODEL=claude-haiku-4-5
AI_FALLBACK_MODEL=claude-sonnet-5

# Primary-model timeout in MILLISECONDS (the TypeScript SDK uses ms, unlike the
# Python SDK's seconds). Kept tight so a failover to the fallback model still
# lands inside the ~10s budget in docs/10-testing.md.
AI_TIMEOUT_MS=6000

# Ask the API to guarantee tool inputs match the schema exactly. Unverified on
# Haiku 4.5 - if a real call returns 400, set this to false. The Zod layer in
# src/schemas/toolInputs.ts validates regardless, so this is belt-and-braces.
AI_STRICT_TOOLS=true

# ---- Auth (MVP) ----
# Shared secret the mobile app sends as `x-api-key`. REQUIRED when
# NODE_ENV=production; optional in development (logs a warning).
MVP_API_KEY=

# ---- Limits ----
# Free-plan daily command cap. Declared now, enforced in v2 (Phase 9).
FREE_DAILY_LIMIT=10

# ---- Monitoring ----
SENTRY_DSN=

# ---- v2: not read by any code yet (Phase 9-10) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
